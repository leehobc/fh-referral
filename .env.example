# Copy this file to ".env" (same folder as docker-compose.yml) and edit.

# Port the website is reachable on, on your NAS (http://<NAS-IP>:8098)
APP_PORT=8098

# Database
DB_NAME=fh_referral
DB_USER=fh_user
DB_PASSWORD=change_this_db_password
DB_ROOT_PASSWORD=change_this_root_password

# Security — MUST change this to a long random string
JWT_SECRET=replace-with-a-long-random-secret

# Demo clinician auto-created on first run (use these to sign in first)
DEMO_CLINICIAN_ID=DR-10567
DEMO_PASSWORD=changeme123

# Optional: full base URL of the site, used in password-reset links
# e.g. https://fh.yourdomain.com
APP_URL=

# Gemini Enterprise Agent Platform (Vertex AI) Express Mode API key, for the
# clinician "Ask the AI assistant" helper on the referral wizard's Q&A step.
# Uses Vertex AI (Express Mode) rather than a plain Gemini Developer API key
# because the consumer API is IP-geo-blocked in some regions — Vertex AI runs
# under Google Cloud's enterprise terms and isn't subject to that block.
# Leave blank to disable the assistant (the button just won't work).
#
# Get a key at https://console.cloud.google.com/vertex-ai (Express Mode
# sign-up gives you an API key immediately, no GCP project setup needed).
# Note: Express Mode keys are free for 90 days within quota; after that (or
# to raise the quota sooner) add a billing account to the same Cloud project
# from the console — no code change needed either way.
VERTEX_AI_API_KEY=
VERTEX_AI_MODEL=gemini-3.5-flash

# Cloudflare Tunnel token (from Zero Trust -> Networks -> Tunnels).
# Lets https://fh.yourdomain.com reach the app without opening any port
# or touching DSM's reserved 443. Leave blank if not using the tunnel.
CF_TUNNEL_TOKEN=

NODE_ENV=production
